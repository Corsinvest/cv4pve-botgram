<?xml version="1.0" encoding="UTF-8" ?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <OutputType>Library</OutputType>
        <Product>Corsinvest for Proxmox VE Telegram Bot Api</Product>
        <AssemblyTitle>Corsinvest for Proxmox VE Telegram Bot Api</AssemblyTitle>
        <Description>Telegram Bot API library for Proxmox VE management</Description>
        <PackageTags>ProxmoxVE;Api;Client;Rest;Corsinvest;Botgram;Telegram</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Local test feed: every build drops the package in ProxmoxVE\.nupkgs -->
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageOutputPath>..\..\..\.nupkgs\</PackageOutputPath>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

        <!-- Symbols: PDB inside the .nupkg (local debugging) and .snupkg for nuget.org -->
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>
    <ItemGroup>
        <None Include="..\..\icon.png" Pack="true" PackagePath="" />
        <None Include="..\..\README.md" Pack="true" PackagePath="" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Corsinvest.ProxmoxVE.Api.Extension" />
        <PackageReference Include="Telegram.Bot" />
    </ItemGroup>
</Project>